# __ENV_PREFIX___ 本进程配置（不要写进 Sleuth .env，也不要回退读 SLEUTH_*）
# 示例取值与仓库根目录 .env.example 对齐，便于从生产环境抄过来后加前缀。

__ENV_PREFIX___MCP_HOST=127.0.0.1
__ENV_PREFIX___MCP_PORT=__MCP_PORT__

# 与 Sleuth 客户端 SLEUTH_MCP_HEADERS / 各 server headers.Authorization 使用同一 Bearer。
# 留空 = 不装鉴权中间件。GET /health 始终开放。
# __ENV_PREFIX___MCP_TOKEN=

# 设为 1 后：仅演示 ping 会声明 attachment_refs_json（Sleuth 注入会话摘录）。
# 你新写的业务工具必须自己在 mcp_server 里声明同名参数，并在 pipeline 用 summarize_refs。
# 只开本开关、不改代码 = 只有 ping 能收到附件。默认不声明。
# __ENV_PREFIX___ATTACHMENTS=1

# 设为 1 后：不注册新工具。演示 ping 在 message 为空时返回 status=need_input。
# 真实业务必须自己在工具包装函数里列 missing（不要照抄「空 message」），SOP 让模型调 question。
# 用户明确说没有补充后再传 proceed_with_gaps=true。默认关闭，演示 ping 不暂停。
# __ENV_PREFIX___HITL=1

# TODO: 业务密钥只放这里，例如上游 API
# __ENV_PREFIX___API_URL=
# __ENV_PREFIX___API_KEY=

# --- 知识库（与 SLEUTH_KB_* 同一协议：login Cookie ragToken，再 search）---
# 四项配齐才自动注册 kb_search（一般不用改 kb.py）。缺一则不注册。
# 若要在 pipeline 内部检索：from .kb import search。只开配置不会让 ping 去查库。
# __ENV_PREFIX___KB_LOGIN_URL=http://kb.internal.example/v1/auth/login
# __ENV_PREFIX___KB_OPENID=
# __ENV_PREFIX___KB_SERVICEID=
# __ENV_PREFIX___KB_API_URL=http://kb.internal.example/v1/search/api/search
# __ENV_PREFIX___KB_API_TIMEOUT=30
# __ENV_PREFIX___KB_SORT_COUNT=10
# __ENV_PREFIX___KB_KNOWLEDGE_IDS=10752,10753
# __ENV_PREFIX___KB_RECALL_COUNT=10

# --- 本包 LLM（OpenAI 兼容 chat/completions）。三项配齐不会自动调模型。---
# 必须在 pipeline 里调用 chat_completion / complete_json。
# 未配齐时用 Sleuth 注入的 sleuth_llm_json（工具入参里要有这个字段，演示 ping 已声明）。
# __ENV_PREFIX___LLM_BASE_URL=https://api.example.com/v1
# __ENV_PREFIX___LLM_API_KEY=
# __ENV_PREFIX___LLM_MODEL=
# __ENV_PREFIX___LLM_TEMPERATURE=0.2
# __ENV_PREFIX___LLM_TIMEOUT=120
# __ENV_PREFIX___LLM_JSON_MODE=1

# --- 对象存储（与 Sleuth AWS_* / SLEUTH_S3_ENDPOINT 同一形状；本进程自己的前缀）---
# access + secret + bucket + (region 或 endpoint) 配齐才自动注册 emit_file，一般不用改 output.py。
# 会话生成文件请用业务 JSON 的 files[].content_base64，由 Sleuth 加密上传，不必配本包 COS。
# __ENV_PREFIX___AWS_ACCESS_KEY_ID=
# __ENV_PREFIX___AWS_SECRET_ACCESS_KEY=
# __ENV_PREFIX___AWS_DEFAULT_REGION=ap-southeast-1
# __ENV_PREFIX___S3_ENDPOINT=
# __ENV_PREFIX___COS_BUCKET=
# __ENV_PREFIX___COS_PATH_PREFIX=sleuth/files
# 亦可写 __ENV_PREFIX___COS_SECRET_ID / __ENV_PREFIX___COS_SECRET_KEY / __ENV_PREFIX___COS_REGION / __ENV_PREFIX___COS_ENDPOINT
