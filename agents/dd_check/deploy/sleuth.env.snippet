# Paste into Sleuth .env (client). Do NOT put DD_CHECK_* secrets here.

# agent:true registers get_agent_card. --tools-only writes false (tools on every session).
SLEUTH_MCP_SERVERS={"ddcheck":{"type":"remote","url":"http://127.0.0.1:8791/mcp","agent":true}}

# Shared Bearer for every MCP (per-server headers override the same keys).
# Must match DD_CHECK_MCP_TOKEN on the agent process. Empty = no client auth header.
# SLEUTH_MCP_HEADERS={"Authorization":"Bearer change-me"}

# COS / S3 catalog skills (prefix scan). Agent package does not fetch skills.
# Uncomment when agent.md lists catalog_skills names that live on COS.
# SLEUTH_SKILLS_S3=s3://<bucket>/sleuth/skills/

# Legacy (tools only + local files; keep local agent.md + skills paths):
# SLEUTH_MCP_SERVERS={"ddcheck":{"type":"remote","url":"http://127.0.0.1:8791/mcp"}}
# SLEUTH_SKILLS_PATHS=<this-package>/skills
