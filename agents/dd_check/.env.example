# DD_CHECK_ 本进程配置（不要写进 Sleuth .env，也不要回退读 SLEUTH_*）
# 示例取值与仓库根目录 .env.example 对齐，便于从生产环境抄过来后加前缀。

DD_CHECK_MCP_HOST=127.0.0.1
DD_CHECK_MCP_PORT=8791

# 与 Sleuth 客户端 SLEUTH_MCP_HEADERS / 各 server headers.Authorization 使用同一 Bearer。
# 留空 = 不装鉴权中间件。GET /health 始终开放。
# DD_CHECK_MCP_TOKEN=

# 主工具 check_report 声明 attachment_refs_json（Sleuth 注入会话摘录）。
DD_CHECK_ATTACHMENTS=1

# --- 本包检查用 LLM（OpenAI 兼容 chat/completions）。三项配齐才执行检查。---
# DD_CHECK_LLM_BASE_URL=https://api.example.com/v1
# DD_CHECK_LLM_API_KEY=
# DD_CHECK_LLM_MODEL=
# DD_CHECK_LLM_TEMPERATURE=0.2
# DD_CHECK_LLM_TIMEOUT=120
# DD_CHECK_LLM_JSON_MODE=1

# 口径与提示词（默认本包 config/）。路径可覆盖。
# DD_CHECK_CONFIG_DIR=
# DD_CHECK_RUBRIC_PATH=
# DD_CHECK_SYSTEM_PROMPT_PATH=
# DD_CHECK_USER_PROMPT_PATH=
# 0 = 使用 rubric.json 的 kb.max_queries
# DD_CHECK_KB_MAX_QUERIES=0
# 空则使用 rubric.json 的 word.filename（支持 {score} {date}）
# DD_CHECK_WORD_FILENAME=

# --- 知识库（与 SLEUTH_KB_* 同一协议：login Cookie ragToken，再 search）---
# 四项配齐才注册 kb_search；缺一则不注册（不会返回空 sources[] 的空工具）。
# DD_CHECK_KB_LOGIN_URL=http://kb.internal.example/v1/auth/login
# DD_CHECK_KB_OPENID=
# DD_CHECK_KB_SERVICEID=
# DD_CHECK_KB_API_URL=http://kb.internal.example/v1/search/api/search
# DD_CHECK_KB_API_TIMEOUT=30
# DD_CHECK_KB_SORT_COUNT=10
# DD_CHECK_KB_KNOWLEDGE_IDS=10752,10753
# DD_CHECK_KB_RECALL_COUNT=10

# --- 对象存储（与 Sleuth AWS_* / SLEUTH_S3_ENDPOINT 同一形状；本进程自己的前缀）---
# access + secret + bucket + (region 或 endpoint) 配齐才注册 emit_file。
# DD_CHECK_AWS_ACCESS_KEY_ID=
# DD_CHECK_AWS_SECRET_ACCESS_KEY=
# DD_CHECK_AWS_DEFAULT_REGION=ap-southeast-1
# DD_CHECK_S3_ENDPOINT=
# DD_CHECK_COS_BUCKET=
# DD_CHECK_COS_PATH_PREFIX=sleuth/files
# 亦可写 DD_CHECK_COS_SECRET_ID / DD_CHECK_COS_SECRET_KEY / DD_CHECK_COS_REGION / DD_CHECK_COS_ENDPOINT
