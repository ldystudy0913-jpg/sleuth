# dd_reply — 尽调答复框架生成助手（不影响 sleuth/.env）

DD_REPLY_MCP_HOST=127.0.0.1
DD_REPLY_MCP_PORT=8792

# 本地知识目录：生产只需 lexicon.json（禁用词）；风险点只走知识库 API
# DD_REPLY_KB_PATH=

# —— 生产：远程知识库检索（内网 URL 写在本文件即可）——
# 认证方式：使用 RAG_TOKEN 构建 Cookie: ragToken=<token>
DD_REPLY_KB_LOGIN_URL=http://kb.internal.example/v1/auth/login
DD_REPLY_KB_OPENID=your-openid
DD_REPLY_KB_SERVICEID=your-service-id
DD_REPLY_KB_API_URL=http://kb.internal.example/v1/search/api/search
 # 超时秒数
# DD_REPLY_KB_API_TIMEOUT=30
# 远程失败/空结果时是否回退本地 risk_points.json（默认 0=不回退，直接标缺失）
# DD_REPLY_KB_FALLBACK_LOCAL=0

# —— 知识库检索配置（可选，不配置则使用服务默认配置）——
# 排序配置
# DD_REPLY_KB_SORT_COUNT=10
# DD_REPLY_KB_SORT_SCORE=0.85
# DD_REPLY_KB_TIME_COMBINE=false

# 召回配置（至少配置一个知识库ID）
# DD_REPLY_KB_KNOWLEDGE_IDS=10752,10753
# DD_REPLY_KB_RECALL_COUNT=10
# DD_REPLY_KB_ATOM_IDS=atom1,atom2
# DD_REPLY_KB_NODE_IDS=node1,node2
# DD_REPLY_KB_HTML_CLEAR=false
# DD_REPLY_KB_QA_SEARCH_MODE=

# 时间过滤配置
# DD_REPLY_KB_TIME_FILTER_ENABLE=false
# DD_REPLY_KB_TIME_FILTER_BY_DAY=7
# DD_REPLY_KB_TIME_FILTER_START_TIME=2024-01-01
# DD_REPLY_KB_TIME_FILTER_END_TIME=2024-12-31

# 标签配置
# DD_REPLY_KB_TAG_NAME=标注标签
# DD_REPLY_KB_TAG_VALUE_IDS=8867,8868
# DD_REPLY_KB_TAG_VALUE_NAMES=易方达蓝筹,其他
# DD_REPLY_KB_TAG_SEARCH_OPERATION=AND

# 子网类型（默认 dmz）
# DD_REPLY_KB_SUBNET_TYPE=dmz

# OpenAI 兼容 LLM（生成四段框架）
# DD_REPLY_LLM_BASE_URL=https://api.openai.com/v1
# DD_REPLY_LLM_API_KEY=
# DD_REPLY_LLM_MODEL=gpt-4o-mini

# 本地附件安全上限
DD_REPLY_ATTACHMENT_MAX_BYTES=52428800
DD_REPLY_ATTACHMENT_MAX_FILES=20
DD_REPLY_ATTACHMENT_EXCERPT_MAX_CHARS=8000

# 可选：生产 COS 附件（invest_id）；未配置则跳过
# DD_REPLY_ECS_EMODE_B_KEY=
# DD_REPLY_MYSQL_HOST=
# DD_REPLY_MYSQL_PORT=3306
# DD_REPLY_MYSQL_USER=
# DD_REPLY_MYSQL_PASSWORD=
# DD_REPLY_MYSQL_DATABASE=
# DD_REPLY_MYSQL_DDP_FILE_TABLE=ddp_file
# DD_REPLY_COS_SECRET_ID=
# DD_REPLY_COS_SECRET_KEY=
# DD_REPLY_COS_REGION=
# DD_REPLY_COS_BUCKET=
# DD_REPLY_COS_ENDPOINT=
# DD_REPLY_COS_PATH_PREFIX=
