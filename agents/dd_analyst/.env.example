# DD-Check standalone service env (copy to services/dd_check/.env)
# Does NOT affect sleuth/.env

DD_CHECK_HOST=127.0.0.1
DD_CHECK_PORT=8790

# MCP Streamable HTTP (primary integration for Sleuth / other MCP clients)
DD_CHECK_MCP_HOST=127.0.0.1
DD_CHECK_MCP_PORT=8791

# Optional strategy YAML directory (default: package templates)
# DD_CHECK_STRATEGY_DIR=

# Optional sqlite result store（仅可选 HTTP API 落库；MCP 主路径不用）
# 启用前请先按 deploy/ddl_dd_check_result.sql 建好表，代码不会 CREATE
# DD_CHECK_SQLITE_PATH=./dd_check_results.sqlite3

# LangGraph 持久 checkpoint（HITL resume / list / rollback；与结果表分开）
# 启用前请先按 deploy/ddl_langgraph_checkpoint.sql 建好表，代码不会 CREATE
# DD_CHECK_HITL=1 时必须配置本项
# DD_CHECK_CHECKPOINT_SQLITE_PATH=./dd_check_checkpoints.sqlite3

# SM4 key — same as Java ecs.emode.B.key (UTF-8, typically 16 bytes; used as key and IV)
# DD_CHECK_ECS_EMODE_B_KEY=0123456789abcde

# MySQL ddp_file
# DD_CHECK_MYSQL_HOST=127.0.0.1
# DD_CHECK_MYSQL_PORT=3306
# DD_CHECK_MYSQL_USER=
# DD_CHECK_MYSQL_PASSWORD=
# DD_CHECK_MYSQL_DATABASE=
# DD_CHECK_MYSQL_DDP_FILE_TABLE=ddp_file
# DD_CHECK_MYSQL_INVEST_ID_COLUMN=invest_id
# DD_CHECK_MYSQL_LOCATION_PATH_COLUMN=location_path

# COS / S3 compatible
# DD_CHECK_COS_SECRET_ID=
# DD_CHECK_COS_SECRET_KEY=
# DD_CHECK_COS_REGION=
# DD_CHECK_COS_BUCKET=
# DD_CHECK_COS_ENDPOINT=
# DD_CHECK_COS_PATH_PREFIX=

# Safety caps
DD_CHECK_ATTACHMENT_MAX_BYTES=52428800
DD_CHECK_ATTACHMENT_MAX_FILES=20
DD_CHECK_ATTACHMENT_EXCERPT_MAX_CHARS=8000

# Optional LLM for future semantic summary
# DD_CHECK_LLM_BASE_URL=
# DD_CHECK_LLM_API_KEY=
# DD_CHECK_LLM_MODEL=

# Human-in-the-loop (pause after scoring for analyst confirm via MCP resume)
# DD_CHECK_HITL=0
# DD_CHECK_HITL_ON_FAIL_ONLY=0
DD_CHECK_HITL=0
DD_CHECK_HITL_ON_FAIL_ONLY=0
