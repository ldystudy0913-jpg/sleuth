// Example sleuth.jsonc — optional overlay; .env wins for the same keys.
{
  "model": "deepseek-chat",
  // Catalog without provider prefixes — each entry carries its own credentials
  "models": {
    // "deepseek-chat": { "apiKey": "sk-...", "baseURL": "https://api.deepseek.com" },
    // "qwen-max": { "apiKey": "sk-...", "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1" }
  },
  "context_limit": 128000,
  "compaction": { "auto": true, "reserved": 20000 },
  "subagent_depth": 1,
  "default_agent": "build",
  "max_steps": 50,
  // MCP Agent 的展示名写在各包 agent.md（get_agent_card.title），不必在此重复。
  // 未配 title 时，内置 build 对外显示为「通用助手」。
  "agent": {
    "build": {
      "prompt": "You are a senior software engineer working in the user's codebase.",
      "steps": 50
    },
    "plan": {
      "prompt": "You are a careful planner. Explore and propose a plan; do not make changes.",
      "steps": 20
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask"
  },
  "mcp": {
    "timeout": { "startup": 30000, "request": 120000 },
    "retry_seconds": 15,
    "servers": {
      // "mytools": {
      //   "type": "remote",
      //   "url": "https://mcp.example.com/mcp",
      //   "headers": { "Authorization": "Bearer YOUR_TOKEN" }
      // }
    }
  },
  "skills": {
    "refresh_seconds": 300,
    "paths": [],
    "urls": [],
    "s3": []
  },
  "storage": {
    "backend": "sqlite"
  },
  "memory": {
    "backend": "off",
    "og_schema": "aml_gs",
    "vector_kind": "vector",
    "text_kind": "text",
    "top_k": 12,
    "min_score": "0.35",
    "merge_score": "0.85",
    "merge_across_scopes": true,
    "pin_kinds": "preference,forget",
    // 域：output回复呈现 workflow作业步骤 str可疑 dd尽调 screening筛查 rating评级 policy制度 avoid负向 pattern套路 customer客户
    "item_key_domains": "output,workflow,str,dd,screening,rating,policy,avoid,pattern,customer",
    // 方面：output.language回复语言 / str.threshold可疑口径 / workflow.steps作业步骤（完整对照见 sleuth/config.py MemoryConfig）
    "item_keys": "output.language,output.structure,output.tone,workflow.steps,str.threshold,str.steps,str.narrative,dd.steps,dd.sources,screening.steps,screening.hits,rating.factors,rating.scale,policy.branch,policy.head,avoid.verbose_english,avoid.raw_id,pattern.cash_night,pattern.mule,customer.segment,customer.risk_note,customer.id",
    "table_item": "mem_item",
    "table_audit": "mem_audit"
  },
  "acl": {
    "enabled": false,
    "default_agent_open": true,
    "table_org": "mem_org",
    "table_role": "mem_role",
    "table_user": "mem_user",
    "table_grant": "mem_grant"
  }
  // files / kb / OpenGauss DSN via .env
  // "files": { "max_bytes": 52428800, "max_count": 20, "image_mode": "vision" },
  // "kb": { "api_url": "" }
}
