# Copy this file to `.env` (project root) and fill in your values.
# .env is loaded automatically at startup; a real shell export always wins.
# Never commit a real .env — it is in .gitignore.

# --- model (provider/model ref). Used when no --model flag or opencode.json sets one.
OPENCODE_MODEL=openai/gpt-4o

# --- OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Leave OPENAI_BASE_URL unset to use the official endpoint; set it to point at
# a proxy, Azure-compatible, or local server.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenAI-compatible gateways: set BOTH the key and the base_url ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# TOGETHER_API_KEY=...
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# XAI_API_KEY=...
# XAI_BASE_URL=https://api.x.ai/v1
# MISTRAL_API_KEY=...
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

