# =============================================================================
# sleuth 配置（复制为项目根目录 `.env`）
# 已 export 的环境变量不会被覆盖。勿提交真实 `.env`。
# =============================================================================

# --- 模型（没有 provider 前缀、每套 sk/url 不同时用对象目录）---
# SLEUTH_MODEL 填目录里的 key；/model deepseek-chat 即可切换
SLEUTH_MODEL=deepseek-chat
SLEUTH_MODELS={"deepseek-chat":{"apiKey":"sk-ds-...","baseURL":"https://api.deepseek.com"},"qwen-max":{"apiKey":"sk-qw-...","baseURL":"https://dashscope.aliyuncs.com/compatible-mode/v1"}}

# 若只想起短名，可写 model 字段：
# SLEUTH_MODELS={"ds":{"model":"deepseek-chat","apiKey":"sk-...","baseURL":"https://api.deepseek.com"}}

# 传统写法（有 provider 前缀）仍然可用：
# SLEUTH_MODEL=deepseek/deepseek-chat
# SLEUTH_MODELS={"ds":"deepseek/deepseek-chat"}
# SLEUTH_PROVIDERS={"deepseek":{"apiKey":"sk-...","baseURL":"https://api.deepseek.com"}}
# 或 DEEPSEEK_API_KEY=... / DEEPSEEK_BASE_URL=...

SLEUTH_DEFAULT_AGENT=build
SLEUTH_USER_ID=local
# 会话标题与 /sessions 列表时间显示（默认北京时间）
# SLEUTH_TIMEZONE=Asia/Shanghai
SLEUTH_USER_ID=local

# --- 单网关快捷方式（仅一个 OpenAI 兼容接口时用）---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Agent ---
SLEUTH_MAX_STEPS=50
SLEUTH_SUBAGENT_DEPTH=1
SLEUTH_CONTEXT_LIMIT=128000
SLEUTH_COMPACTION_AUTO=true
SLEUTH_TOOL_OUTPUT_MAX_LINES=2000
SLEUTH_TOOL_OUTPUT_MAX_BYTES=50000
# CLI：思考过程超过 N 行则折叠（0=始终折叠）；展开提示可关
# SLEUTH_REASONING_COLLAPSE_LINES=8
# SLEUTH_REASONING_NO_PROMPT=1

# --- 编排模式（默认 Mode A host；详见 docs/ORCHESTRATION.md）---
# SLEUTH_ORCHESTRATION_DEFAULT_MODE=host
# SLEUTH_ORCHESTRATION_DEFAULT_EXECUTION=sync
# SLEUTH_ORCHESTRATION_DEFAULT_DELEGATABLE=0
# SLEUTH_ORCHESTRATION_INVOKE_ENABLED=1
# SLEUTH_ORCHESTRATION_AUTO_RUN_ENABLED=1
# SLEUTH_ORCHESTRATION_PARALLEL_ENABLED=1
# SLEUTH_ORCHESTRATION_ASYNC_ENABLED=0
# SLEUTH_ORCHESTRATION_DELEGATE_ENABLED=1
# SLEUTH_ORCHESTRATION_PARALLEL_MAX_BRANCHES=8
# SLEUTH_ORCHESTRATION_ASYNC_MAX_JOBS_PER_USER=32
# SLEUTH_ORCHESTRATION={"default_mode":"host","async_enabled":false}

# 产品护栏（默认开启）：禁止工具读取 sleuth 源码/系统 prompt/密钥；
# 模型只应公开可用工具与 Skill。自研调试本仓库时可关掉：
# SLEUTH_GUARDRAILS=0

# 输出脱敏（默认开启）：对外可见文本屏蔽身份证/手机/银行卡/密码/标注住址
# SLEUTH_OUTPUT_DESENSITIZE=0
# 13 位 unix 毫秒时间戳不当成银行卡（窗口可配，单位 ms）
# SLEUTH_PRIVACY_SKIP_UNIX_MS=1
# SLEUTH_PRIVACY_UNIX_MS_MIN=946684800000
# SLEUTH_PRIVACY_UNIX_MS_MAX=4102444800000

# --- 存储 ---
SLEUTH_STORAGE_BACKEND=sqlite
# SLEUTH_SQLITE_PATH=
# SLEUTH_MYSQL_HOST=127.0.0.1
# SLEUTH_MYSQL_PORT=3306
# SLEUTH_MYSQL_USER=sleuth
# SLEUTH_MYSQL_PASSWORD=
# SLEUTH_MYSQL_DATABASE=sleuth

# --- 数据目录 ---
# SLEUTH_DATA_DIR=

# --- Skills ---
# SLEUTH_SKILLS_PATHS=~/shared-skills,.sleuth/skills
# SLEUTH_SKILLS_URLS=https://example.com/skills-pack.zip
# SLEUTH_SKILLS_S3=[{"uri":"s3://my-bucket/skills/pack.zip"},{"uri":"s3://my-bucket/skills/team/"}]
# 懒惰 TTL：满间隔后下一次 prompt / GET /v1/skills 才重扫（非后台定时）
SLEUTH_SKILLS_REFRESH_SECONDS=300

# --- AWS / S3（Skill 拉包与会话文件邮箱共用这一套，不要再配 SLEUTH_COS_SECRET_*）---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# SLEUTH_S3_ENDPOINT=
# 桶名来自 SLEUTH_SKILLS_S3 的 s3://桶/... ；会话文件另写 sleuth/files/ 前缀
# SLEUTH_COS_PATH_PREFIX=sleuth/files
# SLEUTH_COS_ADDRESSING_STYLE=virtual
# SLEUTH_COS_SIGNATURE_VERSION=s3v4
# SLEUTH_COS_READ_CHUNK_BYTES=262144
# SLEUTH_FILES_MAX_BYTES=52428800
# SLEUTH_FILES_MAX_COUNT=20
# SLEUTH_FILES_PRESIGN_PUT_EXPIRES=900
# SLEUTH_FILES_PRESIGN_GET_EXPIRES=300
# 空或 * = 不限制；也可 CSV，如 application/pdf,image/*,text/plain
# SLEUTH_FILES_MIME_ALLOW=
# 服务端 SM4-CBC（key==IV）加密后写入 COS；前端只传/收明文。密钥只放本机 .env
# SLEUTH_SM4_KEY=
# SLEUTH_FILES_REQUIRE_ENCRYPT=1
# SLEUTH_FILES_ENC_ALGO=sm4-cbc-kiv
# SLEUTH_FILES_CIPHER_MIME=application/octet-stream
# SLEUTH_FILES_UPLOAD_FORM_FIELD=file
# SLEUTH_FILES_UPLOAD_FILENAME_FIELD=filename
# SLEUTH_FILES_UPLOAD_MIME_FIELD=mime
# SLEUTH_FILES_DOWNLOAD_PATH_TEMPLATE=/v1/sessions/{session_id}/files/{file_id}
# SLEUTH_FILES_DOWNLOAD_DISPOSITION=attachment
# SLEUTH_FILES_INLINE_DISPOSITION=inline
# SLEUTH_FILES_INLINE_QUERY_PARAM=inline
# SLEUTH_FILES_INLINE_QUERY_TRUTHY=1,true,yes,on
# SLEUTH_FILES_INCLUDE_PENDING_QUERY=include_pending
# SLEUTH_FILES_GENERATED_MIME=text/plain; charset=utf-8
# SLEUTH_FILES_DEPRECATED_PRESIGN_MESSAGE=presigned COS upload is retired; POST multipart /v1/sessions/{session_id}/files
# SLEUTH_FILES_DEFAULT_MIME=application/octet-stream
# SLEUTH_FILES_FALLBACK_FILENAME=file
# SLEUTH_FILES_ANONYMOUS_USER_ID=anonymous
# SLEUTH_FILES_FILENAME_MAX_CHARS=180
# SLEUTH_FILES_OBJECT_KEY_SEG_MAX_CHARS=80
# SLEUTH_FILES_HARVEST_FILENAME=output
# SLEUTH_FILES_ALLOWED_URL_SCHEMES=https
# SLEUTH_FILES_BLOCKED_URL_PREFIXES=data:,file:
# SLEUTH_FILES_MIME_WILDCARD=*,*/*
# SLEUTH_FILES_STATUS_READY=ready
# SLEUTH_FILES_EXCERPT_PENDING=pending
# SLEUTH_FILES_EXCERPT_OK=ok
# SLEUTH_FILES_EXCERPT_SKIPPED=skipped
# SLEUTH_FILES_ROLE_USER=user
# SLEUTH_FILES_ROLE_ASSISTANT=assistant
# SLEUTH_FILES_MISSING_UPLOAD_MESSAGE=file is required
# SLEUTH_FILES_ERR_FILE_NOT_FOUND=file not found
# SLEUTH_FILES_ERR_NO_OBJECT_KEY=file has no object_key
# SLEUTH_FILES_ERR_SM4_KEY=SM4 key not configured
# SLEUTH_FILES_ERR_FILENAME_REQUIRED=filename required
# 注入 system prompt 的附件说明（也可用 jsonc files.prompt_preamble 写多行）
# SLEUTH_FILES_PROMPT_PREAMBLE=
# SLEUTH_FILES_PROMPT_ITEM_LINE=- `{id}` {filename} ({mime}, {size} bytes) excerpt_status={status} parser={parser}
# SLEUTH_FILES_PROMPT_EXCERPT_PREFIX=  excerpt{mark}:
# SLEUTH_FILES_PROMPT_TRUNCATED_MARK= (truncated)
# SLEUTH_FILES_PROMPT_SKIPPED_LINE=  skipped: {skipped}
# SLEUTH_FILES_PROMPT_PENDING_LINE=  excerpt: still parsing; use the filename or call read_session_file
# SLEUTH_FILES_EXCERPT_MAX_CHARS=8000
# 带 question 再解析时的正文上限（不覆盖会话已存 excerpt）
# SLEUTH_FILES_EXCERPT_REREAD_MAX_CHARS=50000
# SLEUTH_FILES_IMAGE_MODE=vision
# SLEUTH_FILES_VISION_MODEL=
# SLEUTH_FILES_VISION_PROMPT=先用一两段话说明图片在展示什么（场景、界面或人物、正在发生的动作）；再列出图中全部可见文字。证件或表单按字段列出。看不清的不要编造。
# SLEUTH_FILES_VISION_FOCUS_PROMPT=先回答下面的用户问题，再列出图中全部可见文字。看不清的不要编造。\n用户问题：{question}
# SLEUTH_FILES_PDF_RENDER_DPI=110
# SLEUTH_FILES_PDF_VISION_MAX_PAGES=8
# SLEUTH_FILES_PDF_PAGE_PREFIX=# page {n}\n
# SLEUTH_FILES_IMAGE_EXTS=.jpg,.jpeg,.png,.webp,.gif
# SLEUTH_FILES_PDF_EXTS=.pdf
# SLEUTH_FILES_XLSX_EXTS=.xlsx
# SLEUTH_FILES_XLS_EXTS=.xls
# SLEUTH_FILES_DOCX_EXTS=.docx
# SLEUTH_FILES_TEXT_EXTS=.txt,.md,.csv,.json,.xml,.html,.htm,.log,.yaml,.yml
# SLEUTH_FILES_EXTRACT_CONCURRENCY=2
# SLEUTH_FILES_EXTRACT_TIMEOUT_S=45
# SLEUTH_FILES_PROMPT_WAIT_S=8
# SLEUTH_FILES_PROGRESS_INTERVAL_S=1
# SLEUTH_FILES_WAIT_EXTRACT_BEFORE_MODEL=1
# SLEUTH_FILES_REREAD_ON_QUESTION=0
# SLEUTH_FILES_ACK_EVENT_TYPE=ack
# SLEUTH_FILES_PROGRESS_EVENT_TYPE=progress
# SLEUTH_FILES_MESSAGE_FILE_IDS_KEY=file_ids
# SLEUTH_FILES_STAGE_EXTRACT=extract
# SLEUTH_FILES_STAGE_EXTRACT_PAGE=extract_page
# SLEUTH_FILES_STAGE_EXTRACT_WAIT=extract_wait
# SLEUTH_FILES_STAGE_EXTRACT_DONE=extract_done
# SLEUTH_FILES_REREAD_ARG=reread
# SLEUTH_FILES_PROGRESS_DETAIL_EXTRACT=extracting attachments
# SLEUTH_FILES_PROGRESS_DETAIL_PAGE=page {page}/{pages}
# SLEUTH_FILES_PROGRESS_DETAIL_WAIT=waiting for excerpt
# SLEUTH_FILES_PROGRESS_DETAIL_DONE=excerpt ready

# --- MCP ---
# Tools only (default / backward compatible):
# SLEUTH_MCP_SERVERS={"docs":{"type":"remote","url":"https://mcp.example.com/mcp"}}
# Opt-in: also register Agent from get_agent_card (no local agent.md required):
# SLEUTH_MCP_SERVERS={"ddcheck":{"type":"remote","url":"http://127.0.0.1:8791/mcp","agent":true}}
# Shared Bearer merged into every MCP; per-server headers override the same keys.
# SLEUTH_MCP_HEADERS={"Authorization":"Bearer change-me"}
# SLEUTH_MCP_AGENT_TRUST_PERMISSIONS=0
# SLEUTH_MCP_TIMEOUT_STARTUP=30000
# SLEUTH_MCP_TIMEOUT_REQUEST=120000
# MCP 可晚于 Sleuth 启动；未连上的服务按间隔后台重试（0=关闭，只用 /mcp reload）
# SLEUTH_MCP_RETRY_SECONDS=15

# --- HTTP 服务 ---
SLEUTH_SERVER_HOST=127.0.0.1
SLEUTH_SERVER_PORT=8787
# SLEUTH_SERVER_ADMIN_TOKEN=change-me
SLEUTH_SERVER_DEFAULT_BACKEND=sqlite

# --- 默认 agent（build）远程知识库（与 dd_reply 同一检索 API）---
# 认证：POST login {openId, serviceId} → Cookie ragToken=<token>，再 POST search
# SLEUTH_KB_LOGIN_URL=http://kb.internal.example/v1/auth/login
# SLEUTH_KB_OPENID=
# SLEUTH_KB_SERVICEID=
# SLEUTH_KB_API_URL=http://kb.internal.example/v1/search/api/search
# SLEUTH_KB_API_TIMEOUT=30
# 可选 serviceConfig（不配则走知识库服务默认值）
# SLEUTH_KB_SORT_COUNT=10
# SLEUTH_KB_SORT_SCORE=
# SLEUTH_KB_TIME_COMBINE=0
# SLEUTH_KB_KNOWLEDGE_IDS=10752,10753
# SLEUTH_KB_RECALL_COUNT=10
# SLEUTH_KB_ATOM_IDS=
# SLEUTH_KB_NODE_IDS=
# SLEUTH_KB_HTML_CLEAR=0
# SLEUTH_KB_QA_SEARCH_MODE=
# SLEUTH_KB_TIME_FILTER_ENABLE=0
# SLEUTH_KB_TIME_FILTER_BY_DAY=
# SLEUTH_KB_TIME_FILTER_START_TIME=
# SLEUTH_KB_TIME_FILTER_END_TIME=
# SLEUTH_KB_TAG_NAME=
# SLEUTH_KB_TAG_VALUE_IDS=
# SLEUTH_KB_TAG_VALUE_NAMES=
# SLEUTH_KB_TAG_SEARCH_OPERATION=AND
# SLEUTH_KB_SUBNET_TYPE=dmz

# --- 长期记忆（OpenGauss）与岗位授权（会话库 MySQL/SQLite）---
# 代码不建表。手工 DDL + 每表插入示例：docs/ddl_memory_mysql.sql 、 docs/ddl_memory_opengauss.sql
# SLEUTH_MEMORY_BACKEND=off
# SLEUTH_OG_HOST=
# SLEUTH_OG_PORT=
# SLEUTH_OG_USER=
# SLEUTH_OG_PASSWORD=
# SLEUTH_OG_DATABASE=
# SLEUTH_OG_DSN=
# SLEUTH_OG_SCHEMA=
# SLEUTH_OG_CONNECT_TIMEOUT_S=
# SLEUTH_MEMORY_TABLE_ITEM=
# SLEUTH_MEMORY_TABLE_AUDIT=
# 知识库收纳状态在 mem_item.kb_status（none/nominated/ingested/stale），已有库须按 ddl_memory_opengauss.sql 里的 ALTER 手工加列。
# SLEUTH_MEMORY_VECTOR_KIND=          # vector | floatvector | real_array
# SLEUTH_MEMORY_TEXT_KIND=            # text | jsonb（OpenGauss 无 TEXT 时用 jsonb）
# SLEUTH_EMBEDDING_MODEL=
# SLEUTH_EMBEDDING_DIM=
# SLEUTH_EMBEDDING_BASE_URL=          # OpenAI 兼容根路径 .../v1，或完整 .../v1/embeddings（不要再被拼一层）
# SLEUTH_EMBEDDING_API_KEY=
# SLEUTH_MEMORY_TOP_K=
# SLEUTH_MEMORY_MIN_SCORE=
# SLEUTH_MEMORY_MERGE_SCORE=0.85     # 同一目录键近义覆盖该实例，异义新开一行；>1 关闭合并
# SLEUTH_MEMORY_MERGE_ACROSS_SCOPES=1  # 1=个人近义复用岗位/机构完整键；0=只和自己名下比
# SLEUTH_MEMORY_MAX_ITEMS=
# SLEUTH_MEMORY_MAX_CHARS=
# SLEUTH_MEMORY_PATTERN_TTL_DAYS=
# SLEUTH_MEMORY_SCENARIOS=
# SLEUTH_MEMORY_KINDS=
# SLEUTH_MEMORY_PIN_KINDS=
# 记忆键白名单：不配则用代码默认值。一旦配置是整份替换。库内键必须是英文 domain.aspect。
# 域：output=回复呈现 workflow=作业步骤 str=可疑报告 dd=尽调 screening=筛查
#     rating=评级 policy=制度 avoid=负向约束 pattern=分析套路 customer=客户事实
#     usage=用数习惯
# SLEUTH_MEMORY_ITEM_KEY_DOMAINS=output,workflow,str,dd,screening,rating,policy,avoid,pattern,customer,usage
# 方面：output.language=回复语言 output.structure=回复结构 output.tone=回复语气
#   workflow.steps=个人作业步骤
#   str.threshold=可疑口径 str.steps=可疑步骤 str.narrative=可疑叙述
#   dd.steps=尽调步骤 dd.sources=尽调材料
#   screening.steps=筛查步骤 screening.hits=命中处置
#   rating.factors=评级因子 rating.scale=评级尺度
#   policy.branch=分行制度 policy.head=总行制度
#   avoid.verbose_english=避免英文长段 avoid.raw_id=避免原文证件号
#   pattern.cash_night=夜间现金套路 pattern.mule=分散对手套路
#   customer.segment=客群 customer.risk_note=风险备注 customer.id=客户标识口径
#   usage.tables=常用表 usage.fields=常用字段 usage.habit=其他用数习惯
# SLEUTH_MEMORY_ITEM_KEYS=output.language,output.structure,output.tone,workflow.steps,str.threshold,str.steps,str.narrative,dd.steps,dd.sources,screening.steps,screening.hits,rating.factors,rating.scale,policy.branch,policy.head,avoid.verbose_english,avoid.raw_id,pattern.cash_night,pattern.mule,customer.segment,customer.risk_note,customer.id,usage.tables,usage.fields,usage.habit
# SLEUTH_ACL_ENABLED=
# SLEUTH_ACL_DEFAULT_AGENT_OPEN=
# SLEUTH_ACL_DEFAULT_AGENT_NAME=
# 岗位 grant 的 resource_id 填该值（默认 *）表示该 kind 下全部，含后续新增 agent/skill
# SLEUTH_ACL_WILDCARD_ID=*
# SLEUTH_ACL_TABLE_ORG=
# SLEUTH_ACL_TABLE_ROLE=
# SLEUTH_ACL_TABLE_USER=
# SLEUTH_ACL_TABLE_GRANT=
# HTTP yolo 只跳过 bash/edit 确认，不能绕过岗位 ACL，也不能让 build 看见或调用 agent 型 MCP 工具。

# --- 可选 JSONC ---
# SLEUTH_CONFIG=
# SLEUTH_CONFIG_CONTENT=
